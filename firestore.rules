rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net catching all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // User Collection Rules
    match /users/{userId} {
      allow read, create, update, delete: if isValidId(userId);
    }

    // Cargo Loads Collection Rules
    match /loads/{loadId} {
      allow read, create, update, delete: if isValidId(loadId);
    }

    // Event Logs Collection Rules
    match /logs/{logId} {
      allow read, create, update, delete: if isValidId(logId);
    }

    // Feedbacks Collection Rules
    match /feedbacks/{feedbackId} {
      allow read, create, update, delete: if isValidId(feedbackId);
    }

    // Settings Collection Rules
    match /settings/{settingId} {
      allow read, create, update, delete: if isValidId(settingId);
    }
  }
}
